{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Edit(.claude/fleet/journal/**)",
      "Write(.claude/fleet/journal/runs.jsonl)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(supabase db push*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__Vercel__deploy_to_vercel",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__deploy_edge_function"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "mcp__github__create_pull_request"
    ],
    "allow": [
      "Bash(node scripts/fleet/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git rev-parse*)",
      "Bash(npm run*)",
      "Bash(node scripts/fleet/inspecter-ecrans.mjs*)",
      "Bash(node scripts/fleet/verify-fleet.mjs*)",
      "Read(.claude/fleet/**)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "scripts/fleet/hook-journal.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "scripts/fleet/hook-journal.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "scripts/fleet/hook-journal.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
